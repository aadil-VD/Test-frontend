<div class="product-template js-product-template pdp-v2">
  <div class="product-template__mobile-images d-lg-none">
    <div class="owl-carousel js-product-mobile-images">
      {%- for image in product.images -%}
        <div class="mobile-image__item">
          {% comment %}
            <img
              alt="{{ image | escape }}"
              data-sizes="auto"
              data-srcset="{{ image.src | img_url: '1040x1382', crop: 'center' }} 710w,
              {{ image.src | img_url: '2080x2764', crop: 'center' }} 1420w"
              src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
            class="lazyload" />
          {% endcomment %}
          <img
            alt="{{ image | escape }}"
            data-sizes="auto"
            data-srcset="
              {{ image.src | img_url: '1540x1540' }} 710w,
              {{ image.src | img_url: '3080x3080' }} 1420w
            "
            src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
            class="lazyload"
          >
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-12 col-lg-6">
        <div class="product-template__images d-flex">
          <div class="product-template__thumbnails">
            {%- assign current_variant = product.selected_or_first_available_variant
              | default: product.variants.first
            -%}
            {%- assign compare_at_price = current_variant.compare_at_price -%}
            {%- assign price = current_variant.price -%}
            <div class="js-slider-product-thumbnails">
              {%- for image in product.images -%}
                <div
                  class="thumbnail__item js-thumbnail-item {% if forloop.index == 1 %} active{% endif %}"
                  data-index="{{ forloop.index }}"
                >
                  <img
                    alt="{{ image | escape }}"
                    data-sizes="auto"
                    data-srcset="
                      {{ image.src | img_url: '165x220', crop: 'center' }} 110w,
                      {{ image.src | img_url: '330x440', crop: 'center' }} 220w
                    "
                    src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                    class="lazyload"
                  >
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="product-template__main-images">
            {%- for image in product.images -%}
              <div
                class="main-image__item js-main-image {% if forloop.index == 1 %} active{% endif %}"
                data-index="{{ forloop.index }}"
              >
                {% comment %}
                  <img
                    alt="{{ image | escape }}"
                    data-sizes="auto"
                    data-srcset="{{ image.src | img_url: '1040x1382', crop: 'center' }} 710w,
                    {{ image.src | img_url: '2080x2764', crop: 'center' }} 1420w"
                    src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                  class="lazyload" />
                {% endcomment %}
                <img
                  alt="{{ image | escape }}"
                  data-sizes="auto"
                  data-srcset="
                    {{ image.src | img_url: '1540x1540' }} 710w,
                    {{ image.src | img_url: '3080x3080' }} 1420w
                  "
                  src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                  class="lazyload"
                >
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="product-template__right">
          <h1 class="product-template__title">{{ product.title }}</h1>
          {% if product.metafields.descriptors.subtitle %}
            <p class="product-template__subtitle">{{ product.metafields.descriptors.subtitle }}</p>
          {% endif %}
          <div class="product-template__price">
            {%- assign current_variant = product.selected_or_first_available_variant
              | default: product.variants.first
            -%}
            {%- assign compare_at_price = current_variant.compare_at_price -%}
            {%- assign price = current_variant.price -%}
            {%- assign money_price = price | money -%}
            {%- assign show_discount = false -%}
            {%- assign is_herbs = false -%}
            {%- for collection in product.collections -%}
              {%- if collection.title == 'Herbs' -%}
                {%- assign is_herbs = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless is_herbs -%}
              {%- for collection in product.collections -%} 
                {%- if collection.title == 'Borders' or collection.title == 'Outdoor Plants' or collection.title == '3/set Plant Combinations' or collection.title == '2/set Plant Combinations' or collection.title == 'Plant & Pot Combinations' -%}
                  {%- assign show_discount = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}
            {%- if show_discount -%}
              {%- assign discount_percentage = product.metafields.custom.discount_percentage | default: 25 -%}
            {%- endif -%}
            {% if discount_percentage != blank %}
              {%- assign discount_display = discount_percentage | round: 2 -%}
              {%- assign discount_check = discount_percentage | round -%}
              {%- if discount_display == discount_check -%}
                {%- assign discount_display = discount_check -%}
              {%- endif -%}
              {%- assign one_minus_discount = 100 | minus: discount_percentage -%}
              {%- assign discounted_price = price | times: one_minus_discount | divided_by: 100 -%}
              {%- assign display_price = discounted_price | money | remove: '.00' -%}
              {%- assign formatted_money_price = money_price | remove: '.00' -%}
              <span class="price__new">{{ display_price }}</span>
              <span class="price__compare_price">{{ formatted_money_price }}</span>
              <span class="price__discount-badge">{{ discount_display }}% OFF</span>
            {% elsif compare_at_price > price %}
              {%- assign display_price = money_price | remove: '.00' -%}
              {%- assign formatted_compare_price = compare_at_price | money | remove: '.00' -%}
              <span class="price__new">{{ display_price }}</span>
              <span class="price__old">{{ formatted_compare_price }}</span>
            {% else %}
              {%- assign display_price = money_price | remove: '.00' -%}
              <span class="price__new">{{ display_price }}</span>
            {% endif %}
          </div>
          <span class="upsell__info-text" style="margin-top:1px;">
            {% if product.tags contains 'indoor plants' %}
              (Price varies by plant height)
            {% elsif product.tags contains 'Borders' %}
              (Price varies by border length)
            {% else %}
              {% if product.metafields.productinfo.info_under_price_status == 'true' %}
            <div style="padding-top:8px;" class="product-template__price-info product-template__price product-template__price-text">{{ product.metafields.productinfo.info_under_price_text }}</div>
          {% endif %}
            {% endif %}
          </span>
          {% unless product.tags contains 'indoor plants' %}
            {% if product.metafields.productinfo.good_to_know_status == 'true' %}
              <div class="product-template__good-to-know">
                {% comment %}
                  <div class="good-to-know__title">{{ product.metafields.productinfo.good_to_know_title }}</div>
                {% endcomment %}
                <div class="good-to-know__items d-flex">
                  {% for item in product.metafields.productinfo.good_item_status %}
                    {% assign index = forloop.index | minus: 1 %}
                    {% if product.metafields.productinfo.good_item_status[index] == 'true' %}
                      <div class="good-to-know-item d-flex align-items-center">
                        <div class="good-to-know-item__icon">
                          {% comment %}
                            {% if product.metafields.productinfo.good_icon_svg_code[index] != '' %}
                            {{ product.metafields.productinfo.good_icon_svg_code[index] }}
                            {% else %}
                            <img src="{{ product.metafields.productinfo.good_item_icon_image[index] }}" alt="Icon" />
                            {% endif %}
                          {% endcomment %}

                          {% if product.metafields.productinfo.good_icon_svg_code[index] != blank %}
                            {{ product.metafields.productinfo.good_icon_svg_code[index] }}
                          {% else %}
                            <img src="{{ product.metafields.productinfo.good_item_icon_image[index] }}" alt="Icon">
                          {% endif %}
                        </div>
                        <div class="good-to-know-item__title">
                          {{ product.metafields.productinfo.good_item_title[index] }}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% else %}
              {%- comment -%} Icon logic for Borders collection based on product title {%- endcomment -%}
              {%- assign is_borders_collection = false -%}
              {%- for collection in product.collections -%}
                {%- if collection.title == 'Borders' -%}
                  {%- assign is_borders_collection = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if is_borders_collection -%}
                {% assign border_icons = '' %}
                {% assign border_titles = '' %}
                
                {% if product.title contains 'House' or product.title contains 'White' or product.title contains 'Classic' %}
                  {% assign border_icons = 'easy_to_care' %}
                  {% assign border_titles = 'Easy to care for' %}
                  {% if product.title contains 'House' or product.title contains 'White' %}
                    {% assign border_icons = border_icons | append: ',flowering,pollinator' %}
                    {% assign border_titles = border_titles | append: ',Flowering,Pollinator' %}
                  {% elsif product.title contains 'Classic' %}
                    {% assign border_icons = border_icons | append: ',scented,flowering' %}
                    {% assign border_titles = border_titles | append: ',Scented,Flowering' %}
                  {% endif %}
                {% elsif product.title contains 'Green' %}
                  {% assign border_icons = 'easy_to_care,flowering,year_round' %}
                  {% assign border_titles = 'Easy to care for,Flowering,Year round interest' %}
                {% elsif product.title contains 'Pet' %}
                  {% assign border_icons = 'leave_per_site,leave_per_site,easy_to_care' %}
                  {% assign border_titles = 'Leave as per site,Leave as per site,Easy to care for' %}
                {% elsif product.title contains 'Evergreen' %}
                  {% assign border_icons = 'easy_to_care,year_round,evergreen' %}
                  {% assign border_titles = 'Easy to care for,Year round interest,Evergreen' %}
                {% endif %}
                {% assign border_icons = border_icons | split: ',' %}
                {% assign border_titles = border_titles | split: ',' %}
                
                {%- if border_icons.size > 0 -%}
                  <div class="product-template__good-to-know">
                    <div class="good-to-know__items d-flex">
                      {%- for icon_type in border_icons -%}
                        {%- assign icon_index = forloop.index | minus: 1 -%}
                        <div class="good-to-know-item d-flex align-items-center">
                          <div class="good-to-know-item__icon">
                            {%- case icon_type -%}
                              {%- when 'easy_to_care' -%}
                                <img src="{{ 'icon-easy-to-care.png' | asset_url }}" alt="Easy to care for">
                              {%- when 'flowering' -%}
                                <img src="{{ 'icon-flowering.png' | asset_url }}" alt="Flowering">
                              {%- when 'pollinator' -%}
                                <img src="{{ 'icon-pollinator.png' | asset_url }}" alt="Pollinator">
                              {%- when 'scented' -%}
                                <img src="{{ 'icon-scented.png' | asset_url }}" alt="Scented">
                              {%- when 'year_round' -%}
                                <img src="{{ 'icon-year-round.png' | asset_url }}" alt="Year round interest">
                              {%- when 'evergreen' -%}
                                <img src="{{ 'icon-evergreen.png' | asset_url }}" alt="Evergreen">
                              {%- when 'leave_per_site' -%}
                                <img src="{{ 'icon-leave-per-site.png' | asset_url }}" alt="Leave as per site">
                            {%- endcase -%}
                          </div>
                          <div class="good-to-know-item__title">
                            {{ border_titles[icon_index] }}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {% endif %}
          {% endunless %}
          {% if product.tags contains 'indoor plants' %}
            {% if product.metafields.productinfo.good_to_know_status == 'true' %}
              <div class="product-template__good-to-know">
                {% comment %}
                  <div class="good-to-know__title">{{ product.metafields.productinfo.good_to_know_title }}</div>
                {% endcomment %}
                <div class="good-to-know__items d-flex">
                  {% for item in product.metafields.productinfo.good_item_status %}
                    {% assign index = forloop.index | minus: 1 %}
                    {% if product.metafields.productinfo.good_item_status[index] == 'true' %}
                      <div class="good-to-know-item d-flex align-items-center">
                        <div class="good-to-know-item__icon">
                          {% comment %}
                            {% if product.metafields.productinfo.good_icon_svg_code[index] != '' %}
                            {{ product.metafields.productinfo.good_icon_svg_code[index] }}
                            {% else %}
                            <img src="{{ product.metafields.productinfo.good_item_icon_image[index] }}" alt="Icon" />
                            {% endif %}
                          {% endcomment %}

                          {% if product.metafields.productinfo.good_icon_svg_code[index] != blank %}
                            {{ product.metafields.productinfo.good_icon_svg_code[index] }}
                          {% else %}
                            <img src="{{ product.metafields.productinfo.good_item_icon_image[index] }}" alt="Icon">
                          {% endif %}
                        </div>
                        <div class="good-to-know-item__title">
                          {{ product.metafields.productinfo.good_item_title[index] }}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% else %}
              {%- comment -%} Icon logic for Borders collection based on product title {%- endcomment -%}
              {%- assign is_borders_collection = false -%}
              {%- for collection in product.collections -%}
                {%- if collection.title == 'Borders' -%}
                  {%- assign is_borders_collection = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if is_borders_collection -%}
                {% assign border_icons = '' %}
                {% assign border_titles = '' %}
                
                {% if product.title contains 'House' or product.title contains 'White' or product.title contains 'Classic' %}
              {% assign border_icons = 'easy_to_care' %}
              {% assign border_titles = 'Easy to care for' %}
              {% if product.title contains 'House' or product.title contains 'White' %}
                {% assign border_icons = border_icons | append: ',flowering,pollinator' %}
                {% assign border_titles = border_titles | append: ',Flowering,Pollinator' %}
              {% elsif product.title contains 'Classic' %}
                {% assign border_icons = border_icons | append: ',scented,flowering' %}
                {% assign border_titles = border_titles | append: ',Scented,Flowering' %}
              {% endif %}
            {% elsif product.title contains 'Green' %}
              {% assign border_icons = 'easy_to_care,flowering,year_round' %}
              {% assign border_titles = 'Easy to care for,Flowering,Year round interest' %}
            {% elsif product.title contains 'Pet' %}
              {% assign border_icons = 'leave_per_site,leave_per_site,easy_to_care' %}
              {% assign border_titles = 'Leave as per site,Leave as per site,Easy to care for' %}
            {% elsif product.title contains 'Evergreen' %}
              {% assign border_icons = 'easy_to_care,year_round,evergreen' %}
              {% assign border_titles = 'Easy to care for,Year round interest,Evergreen' %}
            {% endif %}
            {% assign border_icons = border_icons | split: ',' %}
            {% assign border_titles = border_titles | split: ',' %}
            
            {%- if border_icons.size > 0 -%}
              <div class="product-template__good-to-know">
                <div class="good-to-know__items d-flex">
                  {%- for icon_type in border_icons -%}
                    {%- assign icon_index = forloop.index | minus: 1 -%}
                    <div class="good-to-know-item d-flex align-items-center">
                      <div class="good-to-know-item__icon">
                        {%- case icon_type -%}
                          {%- when 'easy_to_care' -%}
                            <img src="{{ 'icon-easy-to-care.png' | asset_url }}" alt="Easy to care for">
                          {%- when 'flowering' -%}
                            <img src="{{ 'icon-flowering.png' | asset_url }}" alt="Flowering">
                          {%- when 'pollinator' -%}
                            <img src="{{ 'icon-pollinator.png' | asset_url }}" alt="Pollinator">
                          {%- when 'scented' -%}
                            <img src="{{ 'icon-scented.png' | asset_url }}" alt="Scented">
                          {%- when 'year_round' -%}
                            <img src="{{ 'icon-year-round.png' | asset_url }}" alt="Year round interest">
                          {%- when 'evergreen' -%}
                            <img src="{{ 'icon-evergreen.png' | asset_url }}" alt="Evergreen">
                          {%- when 'leave_per_site' -%}
                            <img src="{{ 'icon-leave-per-site.png' | asset_url }}" alt="Leave as per site">
                        {%- endcase -%}
                      </div>
                      <div class="good-to-know-item__title">
                        {{ border_titles[icon_index] }}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
                {%- endif -%}
              {%- endif -%}
            {% endif %}
          {% endif %}
          {% if product.metafields.productinfo.switcher_status == 'true' %}
            <div class="product-template__options">
              <div class="option__title">{{ product.metafields.productinfo.switcher_title }}</div>
              <div class="option__active-value js-open-options" data-id="990">{{ product.title }}</div>
              <div class="option__values js-option" data-id="990">
                {% for item in product.metafields.productinfo.product_switcher %}
                  {% assign index = forloop.index | minus: 1 %}
                  {% assign get_product = product.metafields.productinfo.product_switcher[index] %}
                  {% assign looked_products = all_products[get_product] %}
                  <div class="option__value">
                    <a href="{{ looked_products.url }}">{{ looked_products.title }}</a>
                  </div>
                {% endfor %}
              </div>
            </div>
            {% if product.metafields.custom.product_variants_info %}
              <span class="pdp_varaint-info">{{ product.metafields.custom.product_variants_info }} </span>
            {% endif %}
          {% endif %}
          <form id="product-form-{{ product.id }}" class="product-form">
          {%- unless product.options.size == 1 and product.variants[0].title == 'Default Title' -%}
            {%- for option in product.options_with_values -%}
              <div
                class="product-template__options js-options"
                data-id="{{ forloop.index }}"
                data-option="option{{ forloop.index }}"
              >
                {% if product.tags contains 'indoor plants' %}
                  <div class="option__title">{{ option.name }}</div>
                  <div class="option__radio">
                    {% for value in option.values %}
                      {% assign variantFound = false %}
                      {%- for variant in product.variants -%}
                        {% if variant.title == value %}
                          {% unless variant.available %}
                            {% continue %}
                          {% endunless %}
                          {% assign variantFound = true %}
                          <label>
                            <input
                              data-id="{{variant.id}}"
                              type="radio"
                              name="{{ option.name }}"
                              value="{{ value }}"
                              data-price="{{ variant.price }}"
                              {% if option.selected_value == value %}
                                checked
                              {% endif %}
                            >
                            <span>{{ value }}</span>
                          </label>
                          {% break %}
                        {% endif %}
                      {%- endfor -%}
                      {% if variantFound == false %}
                        {%- for variant in product.variants -%}
                          {% assign variantId = variant.id %}
                        {%- endfor -%}
                        <label>
                          <input
                            data-id="{{variantId}}"
                            type="radio"
                            name="{{option.name}}"
                            value="{{ value }}"
                            data-price="{{ variant.price }}"
                            {% if option.selected_value == value %}
                              checked
                            {% endif %}
                          >
                          <span>{{ value }}</span>
                        </label>
                      {% endif %}
                    {% endfor %}
                  </div>
                  {% if option.values.size > 1 %}
                    <span class="upsell__info-text">Choose a size based on where you plan to place the plant</span>
                  {% endif %}
                {% else %}
                  <div class="option__title">
                    {{ 'products.product.select' | t }}
                    {{ option.name }}
                  </div>
                  <div class="option__active-value js-open-options" data-id="{{ forloop.index }}">
                    {%- for value in option.values -%}
                      {% if option.selected_value == value %}
                        {{ value }}
                        {%- for variant in product.variants -%}
                          {% if variant.title == value %}
                            {% unless variant.available %}
                              - {{ 'products.product.notify_me' | t }}
                            {% endunless %}
                          {% endif %}
                        {%- endfor -%}
                      {% endif %}
                    {%- endfor -%}
                  </div>
                  <div class="option__values js-option" data-id="{{ forloop.index }}">
                    {%- for value in option.values -%}
                      <div class="option__value js-option-value" data-value="{{ value }}">
                        {{ value }}
                        {%- for variant in product.variants -%}
                          {% if variant.title == value %}
                            {% unless variant.available %}
                              - {{ 'products.product.notify_me' | t }}
                            {% endunless %}
                          {% endif %}
                        {%- endfor -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {% endif %}
              </div>
            {%- endfor -%}
            {% if product.tags contains 'Borders' %}
              <span class="upsell__info-text">Choose a size based on where you plan to place the border</span>
            {% endif %}
          {% endunless %}

          {% if product.tags contains 'indoor plants' -%}
          {%- else %}
            {% if product.metafields.productinfo.upsell_status == 'true' %}
              <div class="product-teplate__upsell">
                <div class="upsell__title">
                  {{ product.metafields.productinfo.upsell_title }}
                  <small style="font-style:italic">(Optional)</small>
                </div>
                <div class="upsell__carousel owl-carousel js-carousel-upsell-products">
                  {% for item in product.metafields.productinfo.upsell_product %}
                    {% assign index = forloop.index | minus: 1 %}
                    {% assign get_variant = product.metafields.productinfo.upsell_variant[index] %}
                    {% if get_variant != '' %}
                      {% assign get_variant_details = get_variant | split: ':' %}
                      {% for get_variant_detail in get_variant_details %}
                        {% if forloop.index == 1 %}
                          {% assign get_product = get_variant_detail %}
                        {% else %}
                          {%- assign current_variant = get_variant_detail | plus: 0 -%}
                        {% endif %}
                      {% endfor %}
                      {% assign looked_products = all_products[get_product] %}
                      {%- for variant in looked_products.variants -%}
                        {% if variant.id == current_variant %}
                          {% assign current_variant = variant %}
                        {% endif %}
                      {%- endfor -%}
                      <div class="upsell__item">
                        <div class="js-match-height-upsell-item position-relative">
                          <input
                            class="upsell-item-checkbox js-upsell-checkbox"
                            type="checkbox"
                            name="upsell_product[]"
                            value="{{ current_variant.id }}"
                            data-variant-id="{{ current_variant.id }}"
                            data-price="{{ current_variant.price }}"
                          >
                          <span class="check-icon">
                            <img
                              src="{{ "CheckCircle.png" | asset_img_url }}"
                              width="26"
                              height="26"
                              style="width:26px"
                              alt="check-mark"

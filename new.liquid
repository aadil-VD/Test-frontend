<script>
  document.addEventListener('DOMContentLoaded', function () {
    const pdp = document.querySelector('.pdp-v2 .add-to-cart-wrapper');
    const stickyBtn = document.querySelector('.add-to-cart-button-fixed');

    if (!pdp || !stickyBtn) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          // PDP left viewport from TOP
          stickyBtn.classList.add('show');
        } else {
          stickyBtn.classList.remove('show');
        }
      },
      {
        root: null,
        threshold: 0,
      }
    );
    observer.observe(pdp);
  });

  {% comment %} $('.js-accordion-title').on('click', function () {
    const $currentAccordion = $(this).closest('.js-accordion');

    // Close all others
    $('.js-accordion-content').not($currentAccordion.find('.js-accordion-content')).slideUp(300);

    // Toggle current
    $currentAccordion.find('.js-accordion-content').slideToggle(300);
  }); {% endcomment %}

  // Mark default-open accordion as active so minus icon shows
  $(document).ready(function () {
    $('.js-accordion').each(function () {
      if ($(this).find('.js-accordion-content').is(':visible')) {
        $(this).addClass('active');
      }
    });
  });

  // Update add to cart button price when upsell items are selected
  function updateAddToCartPrice() {
    var plantPrice = 0;
    var upsellPrice = 0;
    
    // Get the main product price from the selected variant
    var selectedVariantPrice = $('#product-select option:selected').data('price');
    if (!selectedVariantPrice) {
      // Fallback to getting price from the select value
      var variantId = $('#product-select').val();
      var productJson = $('#ProductJson').text();
      if (productJson) {
        try {
          var product = JSON.parse(productJson);
          var variant = product.variants.find(function(v) { return v.id == variantId; });
          if (variant) {
            plantPrice = variant.price;
          }
        } catch(e) {
          console.error('Error parsing product JSON:', e);
        }
      }
    } else {
      plantPrice = selectedVariantPrice;
    }
    
    // Apply discount if applicable
    var discountData = document.getElementById('ProductDiscountData') ? JSON.parse(document.getElementById('ProductDiscountData').innerHTML) : null;
    var discountPercentage = discountData && discountData.discount_percentage;
    if (discountPercentage) {
      var oneMinusDiscount = 100 - discountPercentage;
      plantPrice = Math.round((plantPrice * oneMinusDiscount) / 100);
    }
    
    // Get selected upsell items price
    $('.js-upsell-checkbox:checked').each(function() {
      var itemPrice = parseFloat($(this).attr('data-price')) || 0;
      upsellPrice += itemPrice;
    });
    
    var totalPrice = plantPrice + upsellPrice;
    
    // Format price
    var formattedPrice = '£' + (totalPrice / 100).toFixed(2);
    formattedPrice = formattedPrice.replace('.00', '');
    
    // Update all add to cart buttons
    $('.js-add-bundle-to-cart .price__new').text(formattedPrice);
  }
  
  // Listen for upsell checkbox changes
  $(document).on('change', '.js-upsell-checkbox', function() {
    updateAddToCartPrice();
  });
  
  // Listen for variant changes
  $(document).on('change', '#product-select', function() {
    updateAddToCartPrice();
  });
  
  // Listen for radio button changes (for plant height selection)
  $(document).on('change', '.option__radio input[type="radio"]', function() {
    updateAddToCartPrice();
  });
  
  // Initial price update on page load
  $(document).ready(function() {
    updateAddToCartPrice();
  });
</script>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const container = document.querySelector('[data-section-id="{{ section.id }}"]');

    if (!container) return;

    // Show badge after DOM is ready to prevent flash of unstyled content
    function showBadges() {
      const badges = container.querySelectorAll('.product-badge');
      badges.forEach(badge => {
        badge.classList.add('loaded');
      });
    }

    // Try to show badges as soon as possible
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', showBadges);
    } else {
      // DOM already loaded
      showBadges();
    }

    // Fallback: ensure badges show after a short delay regardless
    setTimeout(showBadges, 100);

    // Image Gallery - Switch main image on thumbnail click
    const mainImage = container.querySelector('#mainProductImage-{{ section.id }}');
    const thumbnails = container.querySelectorAll('.thumbnail');

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', function () {
        const imageUrl = this.dataset.imageUrl;

        if (mainImage && imageUrl) {
          mainImage.src = imageUrl;
        }

        thumbnails.forEach((thumb, i) => {
          thumb.classList.toggle('active', i === index);
        });
      });
    });

    // Scent Selection
    const scentOptions = container.querySelectorAll('.scent-option');
    const variantInput = container.querySelector('#selectedVariant-{{ section.id }}');

    scentOptions.forEach((option) => {
      option.addEventListener('click', function () {
        const clickedOption = this;
        scentOptions.forEach((opt) => opt.classList.remove('selected'));
        clickedOption.classList.add('selected');

        // Update variant ID if present
        const variantId = clickedOption.getAttribute('data-variant-id');
        if (variantInput && variantId) {
          variantInput.value = variantId;
        }

        // Update thumbnails if variant has thumbnail images
        const currentThumbnails = container.querySelectorAll('.thumbnail');
        currentThumbnails.forEach((thumbnail, index) => {
          const thumbNum = index + 1;
          // Use getAttribute to get hyphenated data attributes
          const thumbLargeUrl = clickedOption.getAttribute('data-thumb-' + thumbNum);
          const thumbSmallUrl = clickedOption.getAttribute('data-thumb-' + thumbNum + '-small');

          if (thumbLargeUrl && thumbSmallUrl) {
            // Update the thumbnail's data-image-url for when it's clicked
            thumbnail.setAttribute('data-image-url', thumbLargeUrl);

            // Update the thumbnail image src
            const thumbImg = thumbnail.querySelector('img');
            if (thumbImg) {
              thumbImg.src = thumbSmallUrl;
            }
          }
        });

        // Reset active state to first thumbnail and show its image as main image
        currentThumbnails.forEach((thumb, i) => {
          if (i === 0) {
            thumb.classList.add('active');
            // Update main image to first thumbnail of selected scent
            const firstThumbUrl = clickedOption.getAttribute('data-thumb-1');
            if (mainImage && firstThumbUrl) {
              mainImage.src = firstThumbUrl;
            }
          } else {
            thumb.classList.remove('active');
          }
        });
      });
    });

    // Accordion - independent toggle (multiple can be open)
    const accordionHeaders = container.querySelectorAll('.accordion-header');

    accordionHeaders.forEach((header) => {
      header.addEventListener('click', function () {
        const item = this.parentElement;
        item.classList.toggle('active');
      });
    });

    // Form submission with loading state
    const productForm = container.querySelector('#productForm-{{ section.id }}');
    if (productForm) {
      productForm.addEventListener('submit', function (e) {
        const submitButton = this.querySelector('.cta-button');
        if (submitButton) {
          submitButton.classList.add('loading');
        }
      });
    }
  })();
</script>


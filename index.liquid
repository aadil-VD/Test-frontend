<script>
  // Function to initialize a swiper with thumbnails
  function initSwiper(mainClass, thumbClass) {
    const swiperThumbs = new Swiper(thumbClass, {
      spaceBetween: 10,
      slidesPerView: 6,
      freeMode: true,
      watchSlidesProgress: true,
      breakpoints: {
        640: {
          slidesPerView: 6,
        },
      },
    });

    const swiperMain = new Swiper(mainClass, {
      spaceBetween: 10,
      navigation: {
        nextEl: mainClass + ' .swiper-button-next',
        prevEl: mainClass + ' .swiper-button-prev',
      },
      pagination: {
        el: mainClass + ' .swiper-pagination',
        clickable: true,
      },
      thumbs: {
        swiper: swiperThumbs,
      },
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      loop: true,
    });
  }

  // Initialize all sliders
  initSwiper('.swiper-main-1', '.swiper-thumbs-1');
  initSwiper('.swiper-main-2', '.swiper-thumbs-2');

  document.addEventListener('change', function (e) {
    if (e.target.matches('.choose-product-variant')) {
      document.getElementById('selectedProductVariant').value = e.target.value;

      // Update price display
      const priceContainer = document.getElementById('productPrice');
      const currentPriceEl = priceContainer.querySelector('.current-price');
      let comparePriceEl = priceContainer.querySelector('.compare-price');

      const newPrice = e.target.dataset.price;
      const newComparePrice = e.target.dataset.comparePrice;
      const hasCompare = e.target.dataset.hasCompare === 'true';

      // Update current price
      currentPriceEl.textContent = newPrice;

      // Handle compare price
      if (hasCompare && newComparePrice) {
        if (comparePriceEl) {
          comparePriceEl.textContent = newComparePrice;
        } else {
          // Create compare price element if it doesn't exist
          comparePriceEl = document.createElement('del');
          comparePriceEl.className = 'compare-price';
          comparePriceEl.textContent = newComparePrice;
          priceContainer.appendChild(comparePriceEl);
        }
      } else if (comparePriceEl) {
        // Remove compare price if variant doesn't have one
        comparePriceEl.remove();
      }
    }
  });
</script>

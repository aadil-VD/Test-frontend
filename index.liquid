<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css">
<script
  src="https://code.jquery.com/jquery-3.7.1.min.js"
  integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
  crossorigin="anonymous"
></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"></script>

{% assign first_scent_option = null %}
{% for block in section.blocks %}
  {% if block.type == 'scent_option' and first_scent_option == null %}
    {% assign first_scent_option = block %}
  {% endif %}
{% endfor %}
<div class="pdp-section" data-section-id="{{ section.id }}">
  <div class="pdp-layout">
    <div class="product-gallery">
      <div class="buybox-media-wrapper">
        <div class="swiper-container position-relative ">
          <!-- Main Swiper -->
          <div class="swiper swiper-main swiper-main-1">
            <div class="swiper-wrapper">
              {% for media in product.images %}
                <div class="swiper-slide">
                  {% if forloop.first %}
                    <!-- Product Badge - Only on first slide -->
                    {% assign variant_badge = product.selected_or_first_available_variant.metafields.custom.variant_badge %}
                    {% if variant_badge != blank %}
                      <div class="product-badge image-badge" style=" max-width:100px;">
                        <img src="{{ variant_badge | image_url: width: 200 }}" alt="Product badge" width="110" height="110" >
                      </div>
                    {% endif %}
                  {% endif %}
                  <img src="{{ media | image_url: width: 600, height: 600, crop: 'center' }}">
                </div>
              {% endfor %}
            </div>
          </div>

          <!-- Thumbnail Swiper -->
          <div class="swiper swiper-thumbs swiper-thumbs-1">
            <div class="swiper-wrapper" style="justify-content: center;">
              {% for media in product.images %}
                <div class="swiper-slide">
                  <img src="{{ media | image_url: width: 100, height: 100, crop: 'center' }}">
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!--
      ================================
      RIGHT COLUMN - PRODUCT INFO
      ================================
    -->
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>
      <p class="product-subtitle">{{ product.metafields.custom.sub_text }}</p>

      <div class="rating-row">
        <span class="stars" style="max-width:100px;">
          <img
            class="star-icon"
            src="{{ section.settings.star_icon | image_url: width: 100 }}"
            alt="Rating stars"
            width="70"
            height="14"
            loading="lazy"
          >
        </span>
        <span class="rating-text">{{ section.settings.rating_value }} / 5 on</span>
        {% if section.settings.review_platform_image != blank %}
          <img
            class="review-platform-image"
            src="{{ section.settings.review_platform_image | image_url: width: 200 }}"
            alt="Review platform"
            style="width: {{ section.settings.review_platform_width }}px; height: {{ section.settings.review_platform_height }}px; padding: {{ section.settings.review_platform_padding }}px;"
            loading="lazy"
          >
        {% endif %}
      </div>

      <p class="price" id="productPrice">
        <span class="current-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
        <del class="compare-price">{{ product.compare_at_price | money }}</del>
        {% endif %}
      </p>

 {% if product.metafields.custom.product_desc != blank %}
  <div class="whats-inside">
    <h3>What's inside the box?</h3>
    {{ product.metafields.custom.product_desc }}
  </div>
{% endif %}


      {% if product.variants_count > 1 %}
        <div class="scent-selection">
          <h3>Choose Your Scent</h3>
          {% for variant in product.variants %}
            <div class="product-option">
              <input
                type="radio"
                name="choose-variant"
                class="choose-product-variant"
                value="{{ variant.id }}"
                id="{{ variant.title | handle }}"
                data-variant="variant-{{ forloop.index }}"
                data-price="{{ variant.price | money }}"
                data-compare-price="{{ variant.compare_at_price | money }}"
                data-has-compare="{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %}"
                {% if forloop.first %}
                  checked
                {% endif %}
              >
              <label class="choose-variant" for="{{ variant.title | handle }}">
                <span class="check-mark"><i class="fa-light fa-circle-check" style="position: absolute;"></i></span>
                <p class="variant-title-heading">{{ variant.title }}</p>
                {% if variant.metafields.custom.variant_subheading %}
                  <p class="variant-subtext">{{ variant.metafields.custom.variant_subheading }}</p>
                {% endif %}
              </label>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <form
        method="post"
        action="/cart/add"
        class="product-form"
        id="productForm-{{ section.id }}"
        enctype="multipart/form-data"
      >
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          id="selectedProductVariant"
        >
        <button type="submit" class="cta-button">
          <span class="loading-spinner"></span>
         <span class="btn-text">{{ product.metafields.custom.text_name | default: product.title }}</span>
        </button>
      </form>

      <p class="free-shipping">
        <span class="shipping-icon">
          {% if section.settings.shipping_icon != blank %}
            <img
              class="shipping-svg"
              src="{{ section.settings.shipping_icon | image_url: width: 36 }}"
              alt="Shipping icon"
              width="18"
              height="18"
              loading="lazy"
            >
          {% else %}
            <svg
              class="shipping-svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 8L18.74 2H5.26L3 8M21 8V21H3V8M21 8H3M12 8V2M6 12H6.01M12 12H12.01M18 12H18.01"/>
            </svg>
          {% endif %}
        </span>
        {{ section.settings.shipping_text }}
      </p>

      <div class="separator-horizontal"></div>

      <div class="trust-badges">
        {% for block in section.blocks %}
          {% if block.type == 'trust_badge' %}
            <div class="trust-badge" {{ block.shopify_attributes }}>
              <div class="trust-badge-icon">
                {% if block.settings.badge_icon != blank %}
                  <img
                    class="icon-svg"
                    src="{{ block.settings.badge_icon | image_url: width: 56 }}"
                    alt="{{ block.settings.badge_text_line1 }} {{ block.settings.badge_text_line2 }}"
                    width="28"
                    height="28"
                    loading="lazy"
                  >
                {% else %}
                  <svg class="icon-svg" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="1.5" stroke="currentColor" fill="none"/>
                    <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                {% endif %}
              </div>
              <p>
                {{ block.settings.badge_text_line1 -}}
                <br>
                {{ block.settings.badge_text_line2 }}
              </p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="accordion">
        {% assign accordion_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'accordion_item' and block.settings.accordion_title != blank %}
            <div class="accordion-item{% if accordion_index == 0 %} active{% endif %}" {{ block.shopify_attributes }}>
              <div class="accordion-header">
                <h3>{{ block.settings.accordion_title }}</h3>
                <span class="accordion-icon"></span>
              </div>
              <div class="accordion-content">
                {{ block.settings.accordion_content }}
              </div>
            </div>
            {% assign accordion_index = accordion_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
    .pdp-section,
    .pdp-section * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;

    }

    .pdp-section {
      font-family: 'Neue Montreal' !important;
      background-color: {{ section.settings.background_color }};
      color: #333;
      line-height: .6;
      max-width: 100%;
      margin: 0 auto;
      padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    }

    .pdp-section .pdp-layout {
      display: grid;
      grid-template-columns: 50% 1fr;
      gap: 60px;
      align-items: start;
    }

    /* ================================
       LEFT COLUMN - PRODUCT GALLERY
       ================================ */
    .pdp-section .product-gallery {
          position: sticky;
          top: 111px;
    }

    /* Product Badge */
    .pdp-section .swiper-container {
      position: relative;
    }

    .pdp-section .swiper-slide {
      position: relative;
    }

    .pdp-section .product-badge {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 10;
      background-color: transparent;
      padding: 0;
      display: none;
    }

    .pdp-section .product-badge.loaded {
      display: block;
    }

    .pdp-section .product-badge img {
      display: block;
      max-width: 110px;
      height: auto;
      width: 110px;
    }

    .pdp-section .main-image {
      width: 627px;
      background-color: transparent;
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      box-shadow: none;
      position: relative;
      z-index: 1;
    }

    .pdp-section .main-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: none;
    }

    .product-option {
      margin-bottom:12px;
    }

    .product-option .choose-variant{
      border-radius:4px;
      margin-bottom:8px;
    }

  .pdp-section .thumbnail-gallery {
    display: flex;
    gap: 8px;
    border-color: #ffffff;
    justify-content: center;
    background: transparent;
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    max-width: 90%;
    flex-wrap: nowrap;
  }

  .pdp-section .thumbnail {
    width: calc((100% - 40px) / 6); /* 6 items with 5 gaps of 8px = 40px */
    max-width: 110px;
    min-width: 70px;
    aspect-ratio: 1;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    flex-shrink: 1;
  }

  .pdp-section .thumbnail:hover {
    border-color: rgba(74, 124, 111, 0.4);
    transform: translateY(-2px);
  }

  .pdp-section .thumbnail.active {
    border-color: #ffffff;
  }

  .pdp-section .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.7);
    transition: filter 0.25s ease;
  }

  .pdp-section .thumbnail.active img {
    filter: brightness(1.1);
  }


    /* ================================
       RIGHT COLUMN - PRODUCT INFO
       ================================ */


  .pdp-section .product-title {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 32px;
    font-weight: 600; /* SemiBold */
    font-style: normal;
    color: #1B1B1B;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

    .pdp-section .product-subtitle {
      font-size: 16px;
      color: #000;
      margin-bottom: 12px;
    }

    .pdp-section .rating-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    .pdp-section .stars {
      display: flex;
      align-items: center;
      gap: 2px;
      font-size: 14px;
    }

    .pdp-section .stars .star-icon {
      width: 90px;
      height: 18px;
      object-fit: contain;
    }

    .pdp-section .stars .star-filled,
    .pdp-section .stars .star-empty {
      line-height: 1;
    }

    .pdp-section .rating-text {
      font-size: 18px;
      color: #1B1B1B;
    }

    .pdp-section .review-platform-image {
      display: inline-block;
      object-fit: contain;
      vertical-align: middle;
    }

    .pdp-section .price {
      font-size: 26px;
      font-weight: 400;
      color: #1b1b1b;
      margin-bottom: 16px;
              line-height:1.4;

    }
    .compare-price {
      font-size: 28px;
      color: #999;
    }
    .current-price {
      font-size: 26px;
      line-height:1.4;
    }

    .pdp-section .whats-inside {
      margin-bottom: 24px;
      font-family: 'Neue Montreal', Arial, sans-serif;

    }

    .pdp-section .whats-inside h3 {
      font-family :'Neue Montreal' !important;
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 16px;
      color: #1B1B1B;
    }

    .pdp-section .whats-inside ul {
      list-style: none;
      padding-left: 8px;
            color: #1B1B1B;

    }

    .pdp-section .whats-inside li {
      font-size: 16px;
      font-weight:500px
      color: #1B1B1B;
      margin-bottom: 10px;
      padding-left: 18px;
      position: relative;
      line-height: 1.5;
    }

    .pdp-section .whats-inside li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: 1B1B1B;
      font-weight: bold;
    }

    .pdp-section .whats-inside li strong {
      font-weight: 500;
      color: #1B1B1B;
    }

    /* Scent Selection */
    .pdp-section .scent-selection {
    margin-bottom: 24px;
    font-family: 'Neue Montreal', sans-serif !important;
    }

    .pdp-section .scent-selection h3 {
      font-family: 'Neue Montreal', sans-serif !important;
      font-size: 18px;
      font-weight: 500;
      margin-bottom: 16px;
      color: #1a1a1a;
      background-color: transparent;
    }

    .pdp-section .scent-option {
      border: 1px solid #e0d9d0;
      border-radius: 5px;
      padding: 18px 20px;
      margin-bottom: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 16px;
      background-color: transparent;
    }

    .pdp-section .scent-option:hover {
      border-color: {{ section.settings.accent_color }};
      background-color: #f5f0e8;
    }

    .pdp-section .scent-option.selected {
      border-color: {{ section.settings.accent_color }};
      background-color: #fff;
    }

    .pdp-section .scent-radio {
      width: 24px;
      height: 24px;
      border: 2px solid #c5bdb3;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      margin-bottom: 22px;
    }

    .pdp-section .scent-option:hover .scent-radio {
      border-color: {{ section.settings.accent_color }};
    }

    .pdp-section .scent-option.selected .scent-radio {
      border-color: {{ section.settings.accent_color }};
      background-color: {{ section.settings.accent_color }};
      transform: scale(1.05);
    }

    .pdp-section .scent-radio::after {
      content: "";
      width: 10px;
      height: 6px;
      border-left: 2px solid white;
      border-bottom: 2px solid white;
      transform: rotate(-45deg) scale(0);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      margin-bottom: 2px;
    }

    .pdp-section .scent-option.selected .scent-radio::after {
      transform: rotate(-45deg) scale(1);
    }

    .pdp-section .scent-details {
      background-color: transparent;
    }

    .pdp-section .scent-details h4 {
      font-family:'Neue Montreal' !important;
      font-size: 18px;
      font-weight: 500;
      color: #2D6775;
      margin-bottom: 4px;
      transition: color 0.3s ease;
    }

    .pdp-section .scent-option:not(.selected) .scent-details h4 {
      color: #1a1a1a;
    }

    .pdp-section .scent-details p {
      font-size: 14px;
      color: #7a7a7a;
      line-height: 1.5;
      transition: color 0.3s ease;
    }

    .pdp-section .scent-option.selected .scent-details p {
      color: {{ section.settings.accent_color }};
      font-weight: 400;        /* Regular */
      font-size: 16px;
      line-height: 24px;
      letter-spacing: 0.02em; /* 2% */
    }

    /* CTA Button */
    .pdp-section .cta-button {
      width: 100%;
      background-color: {{ section.settings.accent_color }};
      color: white;
      border: none;
      padding: 16px 16px 16px 16px;
      border-radius: 50px;
      font-size: 16px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-bottom: 24px;
      letter-spacing: 0.3px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .pdp-section .cta-button.loading {
      pointer-events: none;
      opacity: 0.85;
    }

    .pdp-section .cta-button .btn-text {
      transition: opacity 0.2s ease;
    }

    .pdp-section .cta-button.loading .btn-text {
      opacity: 0.7;
      display :none;
    }

    .pdp-section .cta-button .loading-spinner {
      display: none;
      width: 20px;
      height: 20px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    .pdp-section .cta-button.loading .loading-spinner {
      display: block;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .pdp-section .free-shipping {
      text-align: center;
      font-size: 16px;
      font-weight: 400;        /* Regular */
      color: #1B1B1B;
      margin-bottom: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .pdp-section .separator-horizontal {
      width: 100%;
      height: 1px;
      background-color: #BAB7A6;
      margin-bottom: 32px;
    }

    .pdp-section .shipping-icon {
      font-size: 16px;
      opacity: 0.8;
      display: flex;
      align-items: center;
    }

    .pdp-section .shipping-svg {
      width: 24px;
      height: 24px;
      color: #1B1B1B;
    }

    /* Trust Badges */
    .pdp-section .trust-badges {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      {% comment %} padding: 28px 0; {% endcomment %}
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      margin-bottom: 28px;
    }

    .pdp-section .trust-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      text-align: center;
      padding: 8px 4px;
    }

    .pdp-section .trust-badge-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      margin-bottom: 10px;
      color: #555;
    }

    .pdp-section .trust-badge p {
      font-size: 16px;
      font-weight:400;
      color: #1B1B1B;
      line-height: 24px;
      letter-spacing: 0;
      margin: 0;
    }

    .pdp-section .icon-svg {
      width: 28px;
      height: 28px;
      stroke: #555;
      stroke-width: 1.5;
      fill: none;
      flex-shrink: 0;
    }

    /* Accordion */
    .pdp-section .accordion {
      display: flex;
      flex-direction: column;
      gap: 12px;
      background-color: transparent;
    }

    .pdp-section .accordion-item {
      background-color: #fff;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      border: none;
      box-shadow: none;
    }

    .pdp-section .accordion-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px 16px 20px;
      cursor: pointer;
      transition: color 0.25s ease;
      background-color: #fff;
    }

    .pdp-section .accordion-header:hover {
      color: #1a1a1a;
    }

    .pdp-section .accordion-header h3 {
      font-size: 16px;
      font-weight: 500;
      color: #1a1a1a;
      font-family: 'Neue Montreal' !important;
      background-color: transparent;
    }

    .pdp-section .accordion-icon {
      width: 28px;
      height: 28px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: transparent;
      border-radius: 50%;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  background-color 0.3s ease;
    }

    .pdp-section .accordion-header:hover .accordion-icon {
      transform: scale(1.2) rotate(90deg);
    }

    .pdp-section .accordion-item.active .accordion-icon {
      transform: rotate(180deg);
    }

    .pdp-section .accordion-header:hover .accordion-item.active .accordion-icon,
    .pdp-section .accordion-item.active .accordion-header:hover .accordion-icon {
      transform: rotate(180deg) scale(1.2);
    }

    .pdp-section .accordion-icon::before,
    .pdp-section .accordion-icon::after {
      content: "";
      position: absolute;
      background-color: #000000;
      border-radius: 2px;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                  opacity 0.3s ease,
                  background-color 0.3s ease;
    }

    .pdp-section .accordion-header:hover .accordion-icon::before,
    .pdp-section .accordion-header:hover .accordion-icon::after {
      background-color: #000000;
    }

    .pdp-section .accordion-item.active .accordion-icon::before,
    .pdp-section .accordion-item.active .accordion-icon::after {
      background-color: #000000;
    }

    .pdp-section .accordion-icon::before {
      width: 14px;
      height: 2px;
    }

    .pdp-section .accordion-icon::after {
      width: 2px;
      height: 14px;
    }

    .pdp-section .accordion-item.active .accordion-icon::after {
      transform: rotate(90deg) scaleY(0);
      opacity: 0;
    }

    .pdp-section .accordion-item.active .accordion-icon::before {
      transform: scaleX(1.1);
    }

    .pdp-section .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  padding 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s ease;
      padding: 0 24px 0 20px;
      background-color: #fff;
